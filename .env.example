# NEXUS GTM configuration. Copy to .env. All values have safe local defaults.

NEXUS_ENV=local
NEXUS_SECRET_KEY=change-me-in-prod-please-32-chars-min
NEXUS_ACCESS_TOKEN_TTL_MIN=60

# CORS: comma-separated origins for external clients (Chrome extension, SPA). Empty = same-origin.
NEXUS_CORS_ORIGINS=
# Per-source ingestion timeout (seconds) so a slow signal source can't hang a request.
NEXUS_SOURCE_TIMEOUT_S=8.0

# Alerts: optional outbound webhook for "webhook"-channel alerts. Empty = log only (email is a stub).
NEXUS_ALERT_WEBHOOK_URL=

# Database. Local default is SQLite (zero-setup). Prod example below.
NEXUS_DATABASE_URL=sqlite+aiosqlite:///./nexus.db
# NEXUS_DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus

# Task queue: "memory" (default, single-node) or "redis"
NEXUS_QUEUE_BACKEND=memory
NEXUS_REDIS_URL=redis://localhost:6379/0

# LLM provider: "stub" (default, deterministic, no key), "openai_compat", "anthropic",
# "groq", or "auto" (fallback chain Anthropic -> Groq -> OpenAI-compat -> stub from
# whichever keys are present).
NEXUS_LLM_PROVIDER=stub
NEXUS_LLM_BASE_URL=https://api.openai.com/v1
NEXUS_LLM_API_KEY=
NEXUS_LLM_MODEL=gpt-4o-mini
# Groq (fast, OpenAI-compatible). Primary key + optional comma-separated rotation pool:
# on a 429 the provider rotates to the next key and retries automatically.
NEXUS_GROQ_API_KEY=
NEXUS_GROQ_API_KEYS=

# Browser/scraping provider: "auto" (Scrapling if installed else DuckDuckGo), "scrapling",
# "duckduckgo", or "cloak" (CloakBrowser-Manager CDP endpoint)
NEXUS_BROWSER_PROVIDER=auto
NEXUS_CLOAK_CDP_URL=http://localhost:8080

# Web search backend: duckduckgo (default, no key) | exa | brave | serper.
# Exa rotates across a key pool on 429, same semantics as Groq above.
NEXUS_SEARCH_PROVIDER=duckduckgo
NEXUS_EXA_API_KEY=
NEXUS_EXA_API_KEYS=

# Contact search: "stub" (default, offline — synthetic personas, never persisted, so
# "Find contacts" returns nothing) or "search" (real people via Exa + LLM extraction).
NEXUS_CONTACT_SEARCH_SOURCES=stub

# Continuous Automation + daily ICP discovery (strict fit gate). Off by default so the
# offline dev loop stays zero-network. Each workspace must also opt in via Settings.
# Requires the worker process: python -m nexus.workers.worker
NEXUS_AUTOMATION_ENABLED=false
NEXUS_ICP_DISCOVERY_ENABLED=false
# Fill blank account firmographics from the web crawler (needs a search key to matter).
NEXUS_ACCOUNT_ENRICH_ENABLED=false
