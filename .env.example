# NEXUS GTM configuration. Copy to .env. All values have safe local defaults.

NEXUS_ENV=local
NEXUS_SECRET_KEY=change-me-in-prod-please-32-chars-min
NEXUS_ACCESS_TOKEN_TTL_MIN=60

# CORS: comma-separated origins for external clients (Chrome extension, SPA). Empty = same-origin.
NEXUS_CORS_ORIGINS=
# Per-source ingestion timeout (seconds) so a slow signal source can't hang a request.
NEXUS_SOURCE_TIMEOUT_S=8.0

# Alerts: optional outbound webhook for "webhook"-channel alerts. Empty = log only (email is a stub).
NEXUS_ALERT_WEBHOOK_URL=

# Database. Local default is SQLite (zero-setup). Prod example below.
NEXUS_DATABASE_URL=sqlite+aiosqlite:///./nexus.db
# NEXUS_DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus

# Task queue: "memory" (default, single-node) or "redis"
NEXUS_QUEUE_BACKEND=memory
NEXUS_REDIS_URL=redis://localhost:6379/0

# LLM provider: "stub" (default, deterministic, no key), "openai_compat", "anthropic",
# "groq", or "auto" (fallback chain Anthropic -> Groq -> OpenAI-compat -> stub from
# whichever keys are present).
NEXUS_LLM_PROVIDER=stub
NEXUS_LLM_BASE_URL=https://api.openai.com/v1
NEXUS_LLM_API_KEY=
NEXUS_LLM_MODEL=gpt-4o-mini
# Groq (fast, OpenAI-compatible). Primary key + optional comma-separated rotation pool:
# on a 429 the provider rotates to the next key and retries automatically.
NEXUS_GROQ_API_KEY=
NEXUS_GROQ_API_KEYS=

# Browser/scraping provider: "auto" (Scrapling if installed else DuckDuckGo), "scrapling",
# "duckduckgo", or "cloak" (CloakBrowser-Manager CDP endpoint)
NEXUS_BROWSER_PROVIDER=auto
NEXUS_CLOAK_CDP_URL=http://localhost:8080

# Web search backend: duckduckgo (default, no key) | exa | brave | serper.
# Exa rotates across a key pool on 429, same semantics as Groq above.
NEXUS_SEARCH_PROVIDER=duckduckgo
NEXUS_EXA_API_KEY=
NEXUS_EXA_API_KEYS=

# Contact search: "stub" (default, offline — synthetic personas, never persisted, so
# "Find contacts" returns nothing) or "search" (real people via Exa + LLM extraction).
NEXUS_CONTACT_SEARCH_SOURCES=stub

# Continuous Automation + daily ICP discovery (strict fit gate). Off by default so the
# offline dev loop stays zero-network. Each workspace must also opt in via Settings.
# Requires the worker process: python -m nexus.workers.worker
NEXUS_AUTOMATION_ENABLED=false
NEXUS_ICP_DISCOVERY_ENABLED=false
# Fill blank account firmographics from the web crawler (needs a search key to matter).
NEXUS_ACCOUNT_ENRICH_ENABLED=false

# Signal sources. Two live web sources run together by default: a broad query plus the dork
# library (one precise query per signal kind, biased to recent results). Add `rss` for company
# feeds; add `no_dorks` to drop the dork source, `no_ats` to drop the job-board source (which is
# keyless — Greenhouse/Lever/Ashby serve public JSON — and discovers the board from the company's
# own careers page), `no_public_apis` to drop SEC EDGAR/GitHub/Hacker News. Add `website` to enable
# page-change monitoring (heaviest source: up to four fetches per account, needs a baseline first).
# Optional GitHub token — unauthenticated GitHub allows only 60 requests/hour:
NEXUS_GITHUB_TOKEN= Each dork is one billed search call, so
# NEXUS_SIGNAL_DORK_MAX_QUERIES is the cost dial. A real published-date filter needs an Exa key;
# other providers rely on the year constraint inside each dork.
NEXUS_SIGNAL_SOURCES=demo
NEXUS_SIGNAL_DORK_MAX_QUERIES=4

# Observability. /metrics is ON by default (M15); the instrumentation call is wrapped so an
# incompatible install degrades to "no metrics" rather than breaking the app. The worker exports
# its own registry (job outcomes + state gauges) on its own port, reachable only inside the
# container network.
NEXUS_METRICS_ENABLED=true
NEXUS_WORKER_METRICS_PORT=9100
# Grafana admin password — required only by the monitoring overlay:
#   docker compose -f deploy/docker-compose.prod.yml -f deploy/docker-compose.monitoring.yml up -d
# GRAFANA_ADMIN_PASSWORD=

# Firecrawl (Google-backed keyword search + page scraping). Inert until keyed. Added so signal
# collection is not dependent on a single vendor: keyless DuckDuckGo 403s under crawl volume, and
# Exa is a neural index that does not honour the operator dorks. Firecrawl's `tbs` gives real
# recency filtering on a keyword engine, so "latest" does not require an Exa key.
#   NEXUS_SEARCH_PROVIDER=firecrawl
# NEXUS_FIRECRAWL_API_KEYS is a comma-separated rotation pool (primary key first), same semantics
# as NEXUS_EXA_API_KEYS: a crawl issues several queries per account, so one free-tier key runs out
# fast and the adapter moves to the next on a 429 rather than degrading to "no news".
NEXUS_FIRECRAWL_API_KEY=
NEXUS_FIRECRAWL_API_KEYS=

# Search backend for SIGNAL collection only. Empty = use NEXUS_SEARCH_PROVIDER. Keep them separate:
# lookalikes (find_similar) and company/ICP discovery (search_companies) are Exa-only capabilities,
# so repointing the global setting to diversify signals would silently disable them.
NEXUS_SIGNAL_SEARCH_PROVIDER=
