__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
*.db
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
dist/
build/
node_modules/
.DS_Store
*.log
# Added by code-review-graph
.code-review-graph/
# Local git worktrees for isolated feature work
.worktrees/

# Deployment secrets + release artifacts (never committed)
deploy/.env
# ...and every variant of it. `deploy/.env.bak-premodel` sat untracked with 13 real credential
# lines in it for a whole release cycle: one `git add -A` would have written Groq, Exa, Apify,
# Firecrawl and Stripe keys into history permanently. Matching only the exact filename means the
# habit of copying a secrets file before editing it defeats the rule.
deploy/.env.*
!deploy/.env.example
release/

# Terraform (cloud deploy) — never commit state or per-env secrets
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfvars
!*.tfvars.example
.terraform.lock.hcl

# Local agent / editor tooling — machine-specific, may hold local API keys (never committed)
.claude/
.qoder/
.gemini/
.opencode.json
.mcp.json

# Database dumps / local backups — data artifacts, never committed (deliver via volume or seed)
backups/
*.dump
*.sql
# ...except the partitioning runbook, which is documentation rather than a dump. The blanket
# *.sql rule exists to keep database exports out; this file is the procedure for a maintenance
# window and must survive a fresh clone (tests/test_retention.py asserts it is present).
!scripts/partition_usage_events.sql
nexus.db.stale-*
.audit/
