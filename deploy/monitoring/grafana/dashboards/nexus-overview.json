{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "NEXUS GTM — Service Overview",
  "uid": "nexus-overview",
  "tags": ["nexus"],
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "15s",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "stat",
      "title": "App up",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "up{job=\"nexus-app\"}", "legendFormat": "up" }],
      "fieldConfig": { "defaults": { "mappings": [
        { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
      ] } }
    },
    {
      "type": "timeseries",
      "title": "Request rate (req/s) by status",
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum by (status) (rate(http_requests_total{job=\"nexus-app\"}[5m]))",
        "legendFormat": "{{status}}"
      }]
    },
    {
      "type": "stat",
      "title": "5xx error ratio (5m)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum(rate(http_requests_total{job=\"nexus-app\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=\"nexus-app\"}[5m])),1)"
      }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "steps": [
        { "color": "green", "value": null }, { "color": "red", "value": 0.02 }
      ] } } }
    },
    {
      "type": "timeseries",
      "title": "Latency P50 / P95 / P99 (s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"nexus-app\"}[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"nexus-app\"}[5m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"nexus-app\"}[5m])))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "Requests in progress",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(http_requests_inprogress{job=\"nexus-app\"})", "legendFormat": "in-progress" }]
    }
  ]
}
