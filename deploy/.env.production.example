# NEXUS GTM — production environment. Copy to deploy/.env and fill in.
# deploy.sh creates this for you (with generated secrets) on first run.

# ---- Host -------------------------------------------------------------------
# The public domain Caddy serves (TLS via Let's Encrypt). Change this single
# value to host on any domain. Use "localhost" for a local full-stack test.
DOMAIN=app.autosdr.ai
ACME_EMAIL=admin@autosdr.ai

# ---- Secrets (deploy.sh generates these if left as CHANGE_ME) ---------------
# POSTGRES_PASSWORD  = the DB owner (migrations + trusted worker sweeps).
# NEXUS_APP_DB_PASSWORD = the least-privilege role the API serves as (RLS-enforced).
# NEXUS_SECRET_KEY   = JWT signing secret (production rejects the insecure default).
POSTGRES_PASSWORD=CHANGE_ME
NEXUS_APP_DB_PASSWORD=CHANGE_ME
NEXUS_SECRET_KEY=CHANGE_ME

# ---- Core -------------------------------------------------------------------
NEXUS_ENV=prod
# DATABASE_URL / REDIS_URL / QUEUE_BACKEND are set by docker-compose to the
# in-stack Postgres + Valkey; override here only for external managed services.

# ---- Security hardening (ON in production) ----------------------------------
# Per-IP sliding-window limit on auth endpoints (login/register/reset) — brute-force /
# credential-stuffing defense. Caddy also rate-limits at the edge; this is defense-in-depth.
NEXUS_AUTH_RATE_LIMIT_ENABLED=true
NEXUS_AUTH_RATE_LIMIT_MAX=10
NEXUS_AUTH_RATE_LIMIT_WINDOW_S=60
# De-duplicate mutating POSTs that carry an Idempotency-Key (retries don't double-charge/double-write).
NEXUS_IDEMPOTENCY_ENABLED=true
# Refuse request bodies larger than this (DoS guard). 10 MB fits the CSV uploads; lower if unused.
NEXUS_MAX_REQUEST_BODY_BYTES=10000000
# Prometheus /metrics: exposed on the app but NOT proxied to the public by Caddy (see Caddyfile).
NEXUS_METRICS_ENABLED=true

# ---- Automation (the product's engine; on in production) ---------------------
NEXUS_AUTOMATION_ENABLED=true
# Real signals only: never show reps fabricated demo events.
NEXUS_DEMO_SIGNALS_ENABLED=false
NEXUS_AUTOMATION_TICK_INTERVAL_S=60
NEXUS_DIGEST_INTERVAL_HOURS=24

# Daily ICP auto-discovery: search -> crawl firmographics -> strict fit>=70 gate.
# Each workspace must ALSO opt in (Settings -> Automation). Needs a search key below.
NEXUS_ICP_DISCOVERY_ENABLED=true
# Fill blank account firmographics from the web crawler (also lets discovery rank
# candidates on real headcount/tech instead of search snippets alone).
NEXUS_ACCOUNT_ENRICH_ENABLED=true

# ---- CRM auto-sync (enable when a real CRM connector is configured) ----------
NEXUS_CRM_SYNC_ENABLED=false
# NEXUS_CRM_PROVIDER=salesforce

# ---- LLM provider -------------------------------------------------------------
# "auto" builds a fallback chain (Anthropic -> Groq -> OpenAI-compat -> stub) from
# whichever keys are present, so a provider outage degrades instead of erroring.
# "stub" runs the full product loop deterministically with no API key (pilot mode).
NEXUS_LLM_PROVIDER=auto
# NEXUS_ANTHROPIC_API_KEY=
# Groq: primary key + optional comma-separated rotation pool. On a 429 the provider
# rotates to the next key automatically, so bursty load rides out per-key limits.
# NEXUS_GROQ_API_KEY=
# NEXUS_GROQ_API_KEYS=key2,key3,key4
# NEXUS_LLM_API_KEY=            # any OpenAI-compatible endpoint

# ---- Search / research engines -------------------------------------------------
# Exa powers web search, QA live research, ICP discovery, and contact search.
# Same rotation semantics as Groq (primary + comma-separated pool).
NEXUS_SEARCH_PROVIDER=exa
# NEXUS_EXA_API_KEY=
# NEXUS_EXA_API_KEYS=key2,key3,key4

# Contact search: "search" = real people via Exa + LLM name extraction. The default
# "stub" returns synthetic personas that are never persisted — with it, the account
# "Find contacts" action always comes back empty.
NEXUS_CONTACT_SEARCH_SOURCES=search

# ---- Email verification --------------------------------------------------------
# Deliverability backend. Accepts a single value or a comma-separated FALLBACK CHAIN:
#   reacher = full SMTP mailbox verification -> valid/invalid (also powers email *finding*).
#             MUST run on a separate host/IP (never probe from the app's own IP).
#   dns     = free DNS/MX domain check (no infra): dead/typo domains -> invalid,
#             live mail domains -> risky (the specific mailbox is not SMTP-probed).
#   stub    = syntax-only (offline; every real address stays "unknown").
# "reacher,dns" = Reacher first, DNS as the alternative when Reacher is down/inconclusive.
NEXUS_EMAIL_VERIFY_PROVIDER=reacher,dns
NEXUS_EMAIL_VERIFY_URL=https://verify.example.com/v0/check_email
# Front the verifier with HTTPS + a bearer token so it isn't an open relay:
# NEXUS_EMAIL_VERIFY_AUTH_HEADER=Bearer CHANGE_ME

# ---- Telephony (live calling) --------------------------------------------------
# "stub" (default) is click-to-dial: the rep's own phone dials a tel: link and they log the
# outcome. It is a complete workflow, not a placeholder — leave it here unless you want the
# platform placing calls itself.
#
# "twilio" places real, billable calls. The model is a rep-first bridge: Twilio rings the
# rep's own phone, and when they answer it dials the prospect and joins the two legs. No
# inbound webhook is needed, so this host does not have to be reachable by Twilio.
#
# Selecting twilio without credentials FAILS AT STARTUP rather than silently falling back to
# click-to-dial — a deployment must never believe it is dialling when it is not.
NEXUS_TELEPHONY_PROVIDER=stub
# The caller ID prospects see. Must be a number you own or have verified in Twilio (E.164).
NEXUS_TELEPHONY_FROM_NUMBER=
# Twilio Console -> Account Info. The auth token is a credential: keep it out of source
# control and rotate it if it is ever exposed.
NEXUS_TWILIO_ACCOUNT_SID=
NEXUS_TWILIO_AUTH_TOKEN=
# Record calls, and attach the recording + transcript to the outcome the rep logs.
# OFF by default: recording consent is jurisdictional, and several US states plus much of
# the EU require every party to agree before a call is recorded. Turn this on only once
# your call scripts announce it.
NEXUS_TWILIO_RECORD_CALLS=false

# ---- Optional engines ----------------------------------------------------------
# NEXUS_EMAIL_VERIFIER_URL=
