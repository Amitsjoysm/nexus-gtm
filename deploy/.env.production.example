# NEXUS GTM — production environment. Copy to deploy/.env and fill in.
# deploy.sh creates this for you (with generated secrets) on first run.

# ---- Host -------------------------------------------------------------------
# The public domain Caddy serves (TLS via Let's Encrypt). Change this single
# value to host on any domain. Use "localhost" for a local full-stack test.
DOMAIN=app.autosdr.ai
ACME_EMAIL=admin@autosdr.ai

# ---- Secrets (deploy.sh generates these if left as CHANGE_ME) ---------------
POSTGRES_PASSWORD=CHANGE_ME
NEXUS_SECRET_KEY=CHANGE_ME

# ---- Core -------------------------------------------------------------------
NEXUS_ENV=prod
# DATABASE_URL / REDIS_URL / QUEUE_BACKEND are set by docker-compose to the
# in-stack Postgres + Valkey; override here only for external managed services.

# ---- Automation (the product's engine; on in production) ---------------------
NEXUS_AUTOMATION_ENABLED=true
# Real signals only: never show reps fabricated demo events.
NEXUS_DEMO_SIGNALS_ENABLED=false
NEXUS_AUTOMATION_TICK_INTERVAL_S=60
NEXUS_DIGEST_INTERVAL_HOURS=24

# ---- CRM auto-sync (enable when a real CRM connector is configured) ----------
NEXUS_CRM_SYNC_ENABLED=false
# NEXUS_CRM_PROVIDER=salesforce

# ---- LLM provider -------------------------------------------------------------
# stub runs the full product loop deterministically with no API key (good for a
# pilot); switch to your provider + key for real agent output.
NEXUS_LLM_PROVIDER=stub
# NEXUS_LLM_API_KEY=

# ---- Optional engines ----------------------------------------------------------
# NEXUS_SEARCH_PROVIDER=duckduckgo
# NEXUS_EXA_API_KEY=
# NEXUS_EMAIL_VERIFIER_URL=
