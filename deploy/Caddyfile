# Caddy fronts the app with automatic HTTPS (Let's Encrypt) for whatever DOMAIN
# is set in .env — app.autosdr.ai today, any other domain tomorrow, no other change.
# DOMAIN=localhost gives a self-signed local cert for testing the full stack.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip zstd

	# Long-cache hashed build assets; everything else is API or the SPA shell.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# The SPA shell (index.html) must revalidate on every load, or a deploy strands
	# open tabs on dead chunk URLs (stuck loading screens / error states).
	@shell {
		not path /assets/*
		not path /api/*
	}
	header @shell Cache-Control "no-cache"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# /metrics is internal-only: Prometheus scrapes app:8000 directly on the Docker network.
	# Never expose it publicly (it leaks endpoints, traffic shape, and version fingerprints).
	@metrics path /metrics
	respond @metrics 404

	reverse_proxy app:8000 {
		# SSE streams (campaign/run progress, chat) must not buffer.
		flush_interval -1

		# Ride out a redeploy instead of showing users a 502. The stack runs a single app
		# replica, so `compose up -d app` leaves a few seconds with nothing to proxy to and
		# every request in that window — including CSS — fails. Health checks take the
		# backend out of rotation while it restarts, and lb_try_duration holds the request
		# open until it is back rather than failing it immediately.
		health_uri /health
		health_interval 2s
		health_timeout 2s
		lb_try_duration 30s
		lb_try_interval 500ms
	}
}
